+/// Reuse JSON Schema string normalization, patterns, enums and length checks,
+/// but expose decoded UTF-8 for a native unescaped parameter value.
+pub(crate) fn raw_string_to_llg(builder: GrammarBuilder, schema: Value) -> Result<GrammarResult> {
+    let options = JsonCompileOptions::default();
+    let built = build_schema(schema, &options)?;
+    if !built.warnings.is_empty() { bail!("raw schema has unsupported constraints: {:?}", built.warnings); }
+    let mut compiler = Compiler::new(options, builder);
+    fn regex(compiler: &Compiler, schema: &Schema) -> Result<RegexAst> {
+        match schema {
+            Schema::String(opts) => match compiler.gen_json_string(opts.clone())? {
+                RegexAst::JsonQuote(inner, _) => Ok(*inner),
+                _ => bail!("expected a quoted string schema"),
+            },
+            Schema::AnyOf(options) => Ok(RegexAst::Or(options.iter().map(|s| regex(compiler, s)).collect::<Result<Vec<_>>>()?)),
+            _ => bail!("raw schema must resolve to strings; references and other value types require JSON encoding"),
+        }
+    }
+    let rx = regex(&compiler, &built.schema)?;
+    let id = compiler.builder.add_grammar(LLGuidanceOptions::default(), RegexAst::NoMatch)?;
+    let root = compiler.ast_lexeme(rx)?;
+    compiler.builder.set_start_node(root);
+    Ok(compiler.builder.finalize(id))
+}
