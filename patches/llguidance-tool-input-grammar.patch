+    /// Decide whether L(body) followed by the closing delimiter can contain an
+    /// earlier delimiter. This is CFG x DFA reachability, not a per-terminal
+    /// substring check: recursive rules and delimiters split over terminals count.
+    pub(crate) fn check_tool_delimiter(&self, root: SymIdx, lexer: &mut LexerSpec, stop: &str) -> Result<()> {
+        let pattern = stop.as_bytes();
+        ensure!(!pattern.is_empty() && pattern.len() <= 63, "raw delimiter must contain 1..63 bytes");
+        let n = pattern.len() + 1;
+        let bad = n - 1;
+        let mut next = vec![vec![bad; 256]; n];
+        for state in 0..bad {
+            for byte in 0u16..256 {
+                let mut candidate = pattern[..state].to_vec();
+                candidate.push(byte as u8);
+                next[state][byte as usize] = (0..=bad).rev()
+                    .find(|&k| candidate.ends_with(&pattern[..k])).unwrap();
+            }
+        }
+        let mut reachable = HashSet::default();
+        let mut pending = vec![root.as_usize()];
+        while let Some(idx) = pending.pop() {
+            if !reachable.insert(idx) { continue; }
+            let symbol = &self.symbols[idx];
+            ensure!(symbol.gen_grammar.is_none() && !symbol.props.parametric,
+                    "raw body cannot contain nested/parametric grammars");
+            for rule in &symbol.rules {
+                for (child, _) in &rule.rhs { pending.push(child.as_usize()); }
+            }
+        }
+        ensure!(reachable.len() * n * n <= 4_000_000, "raw boundary proof exceeds compilation budget");
+        let mut relations: HashMap<usize, Vec<u64>> = reachable.iter().map(|&idx| (idx, vec![0; n])).collect();
+        let mut fuel = 20_000_000usize;
+        for &idx in &reachable {
+            let Some(lexeme) = self.symbols[idx].lexeme else { continue; };
+            let rx = lexer.lexemes[lexeme.as_usize()].compiled_rx;
+            let mut dfa = lexer.regex_builder.to_regex_limited(rx, 1_000_000)?;
+            for from in 0..n {
+                let mut queue = vec![(dfa.initial_state(), from)];
+                let mut seen = HashSet::default();
+                while let Some((state, boundary)) = queue.pop() {
+                    if !seen.insert((state, boundary)) { continue; }
+                    if dfa.is_accepting(state) { relations.get_mut(&idx).unwrap()[from] |= 1u64 << boundary; }
+                    for byte in 0u16..256 {
+                        ensure!(fuel > 0, "raw boundary proof exceeds compilation budget");
+                        fuel -= 1;
+                        let target = dfa.transition(state, byte as u8);
+                        if !target.is_dead() { queue.push((target, next[boundary][byte as usize])); }
+                    }
+                }
+            }
+        }
+        loop {
+            let mut changed = false;
+            for &idx in &reachable {
+                for rule in &self.symbols[idx].rules {
+                    for from in 0..n {
+                        let mut states = 1u64 << from;
+                        for (child, _) in &rule.rhs {
+                            let mut result = 0;
+                            while states != 0 {
+                                ensure!(fuel > 0, "raw boundary proof exceeds compilation budget");
+                                fuel -= 1;
+                                let state = states.trailing_zeros() as usize;
+                                states &= states - 1;
+                                result |= relations[&child.as_usize()][state];
+                            }
+                            states = result;
+                        }
+                        let row = &mut relations.get_mut(&idx).unwrap()[from];
+                        changed |= states & !*row != 0;
+                        *row |= states;
+                    }
+                }
+            }
+            if !changed { break; }
+        }
+        let ends = relations[&root.as_usize()][0];
+        ensure!(ends & (1u64 << bad) == 0, "raw tool body can contain its closing delimiter; select a lossless encoding");
+        for state in 0..bad {
+            if ends & (1u64 << state) == 0 { continue; }
+            let mut current = state;
+            for (i, &byte) in pattern.iter().enumerate() {
+                current = next[current][byte as usize];
+                ensure!(current != bad || i + 1 == pattern.len(),
+                        "raw tool body can overlap its closing delimiter; select a lossless encoding");
+            }
+        }
+        Ok(())
+    }
