+    // A quoted terminal cannot remain one greedy lexeme: PATH followed by a
+    // newline shares a '\\' prefix with an escaped backslash inside PATH.
+    // Lower the terminal's DFA to grammar rules and quote individual byte
+    // transitions. Complete JSON escape sequences are then atomic lexemes.
+    fn body_node(&mut self, rx: RegexId) -> Result<NodeRef> {
+        if let Some(node) = self.body_nodes.get(&rx) {
+            return Ok(*node);
+        }
+        let mut dfa = self.builder.regex.spec.regex_builder.to_regex_limited(rx, 1_000_000)?;
+        let initial = dfa.initial_state();
+        let root = self.builder.new_node("quoted_terminal");
+        let mut nodes = HashMap::default();
+        nodes.insert(initial, root);
+        let mut pending = vec![initial];
+        while let Some(state) = pending.pop() {
+            self.builder.check_limits()?;
+            let mut transitions: HashMap<NodeRef, Vec<u32>> = HashMap::default();
+            for byte in 0u16..=255 {
+                let next = dfa.transition(state, byte as u8);
+                ensure!(dfa.cost() <= 1_000_000, "tool input terminal DFA exceeds compilation budget");
+                if next.is_dead() {
+                    continue;
+                }
+                let target = *nodes.entry(next).or_insert_with(|| {
+                    pending.push(next);
+                    self.builder.new_node("quoted_state")
+                });
+                let set = transitions.entry(target).or_insert_with(|| vec![0; 8]);
