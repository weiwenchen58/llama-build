+#include "chat-peg-parser.h"
+#include "chat-auto-parser-helpers.h"
+#include "json-schema-to-grammar.h"
+#include "../src/llama-grammar.h"
+
+#include <cstdio>
+#include <set>
+
+using json = common_json;
+
+// The native parser remains the response parser. Only its sampling grammar changes.
+common_peg_parser common_chat_peg_builder::tool_input(const common_json & function,
+                                                     const common_peg_parser & parser,
+                                                     bool json_object) {
+    if (!function.contains("input_grammar")) {
+        return parser;
+    }
+    return input_grammar(parser, function.at("name"),
+                         function.at("input_grammar").at("definition"), json_object);
+}
+
+static std::string codepoint(uint32_t value) {
+    char buffer[20];
+    snprintf(buffer, sizeof(buffer), "\\x{%x}", value);
+    return buffer;
+}
+
+// Reuse llama.cpp's GBNF parser, including its lowering of repetitions to rules.
+// Translate parsed elements, never splice or regex-edit the generated grammar text.
+static std::string emit_lark(const llama_grammar_parser & parsed, const std::string & prefix,
+                             const std::map<uint32_t, std::string> & bodies = {}) {
+    std::string result;
+    for (size_t i = 0; i < parsed.rules.size(); ++i) {
+        result += prefix + std::to_string(i) + ": ";
+        auto body = bodies.find(i);
+        if (body != bodies.end()) {
+            result += body->second + "\n";
+            continue;
+        }
+        const auto & rule = parsed.rules[i];
+        for (size_t j = 0; j < rule.size(); ++j) {
+            const auto & elem = rule[j];
+            switch (elem.type) {
+                case LLAMA_GRETYPE_END: break;
+                case LLAMA_GRETYPE_ALT: result += " | "; break;
+                case LLAMA_GRETYPE_RULE_REF: result += prefix + std::to_string(elem.value) + " "; break;
+                case LLAMA_GRETYPE_CHAR_ANY: result += "/(?s:.)/ "; break;
+                case LLAMA_GRETYPE_CHAR:
+                case LLAMA_GRETYPE_CHAR_NOT: {
+                    result += elem.type == LLAMA_GRETYPE_CHAR_NOT ? "/[^" : "/[";
+                    result += codepoint(elem.value);
+                    while (j + 1 < rule.size()) {
+                        const auto & next = rule[j + 1];
+                        if (next.type == LLAMA_GRETYPE_CHAR_RNG_UPPER) {
+                            result += "-" + codepoint(next.value);
+                        } else if (next.type == LLAMA_GRETYPE_CHAR_ALT) {
+                            result += codepoint(next.value);
+                        } else {
+                            break;
+                        }
+                        ++j;
+                    }
+                    result += "]/ ";
+                    break;
+                }
+                default: throw std::invalid_argument("input_grammar: unsupported native grammar terminal");
+            }
+        }
+        result += "\n";
+    }
+    return result;
+}
+
+void common_chat_apply_tool_grammars(common_chat_params & data, const std::vector<common_chat_tool> & tools,
+                                    common_chat_tool_choice choice) {
+    std::set<std::string> expected;
+    std::set<std::string> names;
+    bool duplicate_name = false;
+    for (const auto & tool : tools) {
+        duplicate_name |= !names.insert(tool.name).second;
+        if (!tool.input_grammar.empty()) {
+            if (!expected.insert(tool.name).second) {
+                throw std::invalid_argument("input_grammar: duplicate tool name");
+            }
+        }
+    }
+    if (expected.empty() || choice == COMMON_CHAT_TOOL_CHOICE_NONE) {
+        return;
+    }
+    if (duplicate_name) {
+        throw std::invalid_argument("input_grammar: duplicate tool name");
+    }
+#ifndef LLAMA_USE_LLGUIDANCE
+    throw std::invalid_argument("input_grammar requires a build with LLAMA_LLGUIDANCE=ON");
+#endif
+    if (data.format != COMMON_CHAT_FORMAT_PEG_NATIVE || data.grammar.empty()) {
+        throw std::invalid_argument("input_grammar: this template does not provide a native tool grammar");
+    }
+    llama_grammar_parser parsed;
+    if (!parsed.parse(data.grammar.c_str())) {
+        throw std::invalid_argument("input_grammar: cannot parse the native tool grammar");
+    }
+    std::map<uint32_t, std::string> bodies;
+    json grammars = json::array({json::object()});
+    std::set<std::string> bound;
+    for (size_t i = 0; i < data.parser.size(); ++i) {
+        auto * node = std::get_if<common_peg_gbnf_parser>(&data.parser.get(i));
+        if (!node || node->input_grammar.empty()) {
+            continue;
+        }
+        const auto symbol = parsed.symbol_ids.find("tool-input-" + std::to_string(i));
+        if (symbol == parsed.symbol_ids.end()) {
+            throw std::invalid_argument("input_grammar: body binding was hidden by a native grammar override");
+        }
+        bound.insert(node->tool_name);
+        auto name = "body" + std::to_string(i);
+        std::string expression = "@" + name;
+        if (node->input_json) {
+            expression = json("{\"input\":\"").dump() + " " + expression + " " + json("\"}").dump();
+        }
+        bodies[symbol->second] = expression;
+        grammars.push_back({{"name", name}, {"lark_grammar", node->input_grammar},
+                            {"tool_input_mode", node->input_json ? "json_string" : "raw_no_lt"}});
+    }
+    if (bound != expected) {
+        throw std::invalid_argument("input_grammar: this native handler has no supported body binding for every tool");
+    }
+    std::string lark = emit_lark(parsed, "r", bodies);
+    const auto root = "r" + std::to_string(parsed.symbol_ids.at("root"));
+    if (data.grammar_lazy) {
+        std::vector<std::string> markers;
+        for (const auto & trigger : data.grammar_triggers) {
+            const auto marker = trim_whitespace(trigger.value);
+            if (trigger.type != COMMON_GRAMMAR_TRIGGER_TYPE_WORD || marker.empty()) {
+                throw std::invalid_argument("input_grammar: only native word triggers are supported");
+            }
+            markers.push_back(marker);
+        }
+        if (markers.empty()) {
+            throw std::invalid_argument("input_grammar: auto requires a native tool trigger");
+        }
+        auto prefix = build_peg_parser([&](common_peg_parser_builder & p) { return p.until_one_of(markers); });
+        auto gbnf = build_grammar([&](const common_grammar_builder & b) { prefix.build_grammar(b); });
+        llama_grammar_parser prefix_parsed;
+        if (!prefix_parsed.parse(gbnf.c_str())) {
+            throw std::invalid_argument("input_grammar: invalid native trigger grammar");
+        }
+        lark += emit_lark(prefix_parsed, "p");
+        lark += "start: p" + std::to_string(prefix_parsed.symbol_ids.at("root")) + " " + root + "?\n";
+    } else {
+        lark += "start: " + root + "\n";
+    }
+    grammars[0] = {{"name", "native"}, {"lark_grammar", lark}};
+    auto native_markers = data.preserved_tokens;
+    native_markers.push_back(data.generation_prompt);
+    data.grammar = "%llguidance-json\n" + json{{"grammars", grammars}, {"native_tokens", native_markers}}.dump();
+}
