diff --git a/common/chat-tool-grammar.cpp b/common/chat-tool-grammar.cpp
new file mode 100644
index 0000000..a51dcb5
--- /dev/null
+++ b/common/chat-tool-grammar.cpp
@@ -0,0 +1,874 @@
+#include "chat-peg-parser.h"
+#include "chat-auto-parser.h"
+#include "parsers/parsers.h"
+#include "json-schema-to-grammar.h"
+#include "../src/llama-grammar.h"
+#include "../src/unicode.h"
+#include <cstdio>
+#include <set>
+#include <tuple>
+#include <cctype>
+#include <algorithm>
+#ifdef LLAMA_USE_LLGUIDANCE
+#include "llguidance.h"
+#endif
+
+using json = common_json;
+
+static std::string codepoint(uint32_t value) {
+    char buffer[20];
+    snprintf(buffer, sizeof(buffer), "\\x{%x}", value);
+    return buffer;
+}
+
+// Reuse llama.cpp's GBNF parser, including its lowering of repetitions to rules.
+// Translate parsed elements, never splice or regex-edit the generated grammar text.
+static std::string emit_lark(const llama_grammar_parser & parsed, const std::string & prefix,
+                             const std::map<uint32_t, std::string> & bodies = {}) {
+    std::string result;
+    for (size_t i = 0; i < parsed.rules.size(); ++i) {
+        result += prefix + std::to_string(i) + ": ";
+        auto body = bodies.find(i);
+        if (body != bodies.end()) {
+            result += body->second + "\n";
+            continue;
+        }
+        const auto & rule = parsed.rules[i];
+        for (size_t j = 0; j < rule.size(); ++j) {
+            const auto & elem = rule[j];
+            switch (elem.type) {
+                case LLAMA_GRETYPE_END: break;
+                case LLAMA_GRETYPE_ALT: result += " | "; break;
+                case LLAMA_GRETYPE_RULE_REF: result += prefix + std::to_string(elem.value) + " "; break;
+                case LLAMA_GRETYPE_CHAR_ANY: result += "/(?s:.)/ "; break;
+                case LLAMA_GRETYPE_CHAR:
+                case LLAMA_GRETYPE_CHAR_NOT: {
+                    result += elem.type == LLAMA_GRETYPE_CHAR_NOT ? "/[^" : "/[";
+                    result += codepoint(elem.value);
+                    while (j + 1 < rule.size()) {
+                        const auto & next = rule[j + 1];
+                        if (next.type == LLAMA_GRETYPE_CHAR_RNG_UPPER) {
+                            result += "-" + codepoint(next.value);
+                        } else if (next.type == LLAMA_GRETYPE_CHAR_ALT) {
+                            result += codepoint(next.value);
+                        } else {
+                            break;
+                        }
+                        ++j;
+                    }
+                    result += "]/ ";
+                    break;
+                }
+                default: throw std::invalid_argument("input_grammar: unsupported native grammar terminal");
+            }
+        }
+        result += "\n";
+    }
+    return result;
+}
+
+// Only the sampling graph is rewritten. Output keeps the native parser and mapper.
+struct common_chat_tool_grammar {
+    using id = common_peg_parser_id;
+    struct context {
+        std::string tool;
+        std::string argument;
+        std::vector<std::string> forbidden_prefixes;
+    };
+    struct result { id node; bool changed; };
+    struct prefix_arc { size_t from; std::string target; std::string pattern; };
+
+    const common_peg_arena & source;
+    common_peg_arena output;
+    std::map<std::string, std::string> bodies;
+    std::map<std::string, json> parameters;
+    std::map<std::string, json> external;
+    std::set<std::string> bound;
+    std::set<std::string> validated_tools;
+    std::vector<std::string> encoding_errors;
+    std::map<std::tuple<id, std::string, std::string, std::vector<std::string>>, result> cache;
+    size_t visits = 0;
+    bool allow_plain;
+    bool parallel;
+#ifdef LLAMA_USE_LLGUIDANCE
+    LlgTokenizer * byte_tokenizer = nullptr;
+#endif
+
+    common_chat_tool_grammar(const common_peg_arena & parser, const common_chat_templates_inputs & inputs)
+        : source(parser), output(parser), allow_plain(inputs.tool_choice == COMMON_CHAT_TOOL_CHOICE_AUTO), parallel(inputs.parallel_tool_calls) {
+        for (const auto & tool : inputs.tools) {
+            if (tool.name.empty() || tool.name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-") != std::string::npos) {
+                throw std::invalid_argument("input_grammar: tool names must use ASCII letters, digits, underscore, dot or dash");
+            }
+            auto schema = common_chat_tool_parameters(json{{"parameters", json::parse(tool.parameters)}});
+            auto document = common_chat_schema_from_json(schema);
+            if (!document.root->value_types().is_only(common_chat_schema::TYPE_OBJECT)) {
+                throw std::invalid_argument("input_grammar: function parameters must describe an object");
+            }
+            if (!parameters.emplace(tool.name, std::move(schema)).second) {
+                throw std::invalid_argument("input_grammar: duplicate tool name");
+            }
+            if (!tool.input_grammar.empty() && !bodies.emplace(tool.name, tool.input_grammar).second) {
+                throw std::invalid_argument("input_grammar: duplicate tool name");
+            }
+        }
+    }
+    ~common_chat_tool_grammar() {
+#ifdef LLAMA_USE_LLGUIDANCE
+        if (byte_tokenizer) { llg_free_tokenizer(byte_tokenizer); }
+#endif
+    }
+
+    static std::vector<id> children(const common_peg_parser_variant & node) {
+        return std::visit([](const auto & p) -> std::vector<id> {
+            using T = std::decay_t<decltype(p)>;
+            if constexpr (std::is_same_v<T, common_peg_sequence_parser> || std::is_same_v<T, common_peg_choice_parser>) {
+                return p.children;
+            } else if constexpr (std::is_same_v<T, common_peg_repetition_parser> ||
+                std::is_same_v<T, common_peg_and_parser> || std::is_same_v<T, common_peg_not_parser> ||
+                std::is_same_v<T, common_peg_schema_parser> || std::is_same_v<T, common_peg_rule_parser> ||
+                std::is_same_v<T, common_peg_atomic_parser> || std::is_same_v<T, common_peg_tag_parser> ||
+                std::is_same_v<T, common_peg_gbnf_parser> || std::is_same_v<T, common_peg_ac_parser>) {
+                return {p.child};
+            }
+            return {};
+        }, node);
+    }
+
+    std::vector<id> descendants(id root) const {
+        std::vector<id> stack{root}, nodes;
+        std::set<id> seen;
+        while (!stack.empty()) {
+            auto next = stack.back(); stack.pop_back();
+            if (!seen.insert(next).second) { continue; }
+            nodes.push_back(next);
+            auto child = children(source.get(next));
+            stack.insert(stack.end(), child.begin(), child.end());
+            if (auto ref = std::get_if<common_peg_ref_parser>(&source.get(next))) { stack.push_back(source.get_rule(ref->name)); }
+        }
+        return nodes;
+    }
+
+    std::string literal(id node, size_t depth = 0) const {
+        if (depth > 64) { return {}; }
+        return std::visit([&](const auto & p) -> std::string {
+            using T = std::decay_t<decltype(p)>;
+            if constexpr (std::is_same_v<T, common_peg_literal_parser>) { return p.literal; }
+            else if constexpr (std::is_same_v<T, common_peg_tag_parser> || std::is_same_v<T, common_peg_atomic_parser> ||
+                std::is_same_v<T, common_peg_rule_parser>) { return literal(p.child, depth + 1); }
+            return {};
+        }, source.get(node));
+    }
+
+    std::set<std::string> names(id root, const char * tag) const {
+        std::set<std::string> values;
+        for (auto node : descendants(root)) {
+            auto value = std::get_if<common_peg_tag_parser>(&source.get(node));
+            if (value && value->tag == tag) {
+                auto name = literal(value->child);
+                if (name.empty()) { throw std::invalid_argument("input_grammar: native name is not a fixed literal"); }
+                values.insert(name);
+            }
+        }
+        return values;
+    }
+
+    id rule(const std::string & name, const std::string & grammar, id original) {
+        auto value = output.add_parser(common_peg_gbnf_parser{original, grammar});
+        auto node = output.add_parser(common_peg_rule_parser{name, value, false});
+        output.add_rule(name, node);
+        return node;
+    }
+
+    std::string external_rule(json definition) {
+        auto name = "native-body-" + std::to_string(external.size());
+        external.emplace(name, std::move(definition));
+        // Keep external bodies opaque while deriving a native trigger's continuation.
+        rule(name, "[\\U0010fffd]", output.add_parser(common_peg_epsilon_parser{}));
+        return name;
+    }
+
+    bool raw_encoding_is_lossless(const json & definition, const context & ctx) {
+#ifdef LLAMA_USE_LLGUIDANCE
+        if (!byte_tokenizer) {
+            std::vector<uint32_t> lengths(257, 1);
+            std::vector<uint8_t> bytes;
+            for (int c = 0; c < 256; ++c) { bytes.push_back(c); }
+            lengths[256] = 4;
+            bytes.insert(bytes.end(), {255, 'E', 'O', 'S'});
+            LlgTokenizerInit ti = {};
+            ti.vocab_size = 257; ti.tok_eos = 256;
+            ti.token_lens = lengths.data(); ti.token_bytes = bytes.data();
+            ti.use_approximate_greedy_tokenize_fn = true;
+            char error[2048];
+            byte_tokenizer = llg_new_tokenizer(&ti, error, sizeof(error));
+            if (!byte_tokenizer) { throw std::invalid_argument(error); }
+        }
+        LlgConstraintInit init;
+        llg_constraint_init_set_defaults(&init, byte_tokenizer);
+        const auto json_grammar = json{{"grammars", json::array({definition})}}.dump();
+        std::unique_ptr<LlgMatcher, decltype(&llg_free_matcher)> matcher(
+            llg_new_matcher(&init, "llguidance", json_grammar.c_str()), llg_free_matcher);
+        if (!matcher) { throw std::runtime_error("input_grammar: compiler allocation failed"); }
+        if (const auto * error = llg_matcher_get_error(matcher.get())) {
+            encoding_errors.push_back(ctx.tool + ": " + error);
+            return false;
+        }
+        for (const auto & prefix : ctx.forbidden_prefixes) {
+            std::unique_ptr<LlgMatcher, decltype(&llg_free_matcher)> check(llg_clone_matcher(matcher.get()), llg_free_matcher);
+            bool possible = true;
+            for (unsigned char byte : prefix) {
+                if (llg_matcher_compute_mask(check.get()) != 0) { throw std::invalid_argument(llg_matcher_get_error(check.get())); }
+                const auto * mask = llg_matcher_get_mask(check.get());
+                if (!(mask[byte / 32] & (1u << (byte % 32)))) { possible = false; break; }
+                if (llg_matcher_consume_token(check.get(), byte) != 0) { throw std::invalid_argument(llg_matcher_get_error(check.get())); }
+            }
+            if (possible) { encoding_errors.push_back(ctx.tool + ": body can start with a reserved native prefix"); return false; }
+        }
+        return true;
+#else
+        (void) definition; (void) ctx;
+        throw std::invalid_argument("input_grammar requires LLAMA_LLGUIDANCE=ON");
+#endif
+    }
+
+    id sequence(std::vector<id> nodes) {
+        for (auto node : nodes) { if (node == COMMON_PEG_INVALID_PARSER_ID) { return node; } }
+        return output.add_parser(common_peg_sequence_parser{std::move(nodes)});
+    }
+
+    void require_object(const json & schema) const {
+        static const std::set<std::string> supported = {"type", "properties", "required", "additionalProperties", "title", "description"};
+        if (!schema.is_object() || schema.value("type", "") != "object" ||
+            !schema.contains("properties") || !schema.at("properties").is_object()) {
+            throw std::invalid_argument("input_grammar: native object needs explicit properties");
+        }
+        for (const auto & item : schema.items()) {
+            if (!supported.count(item.key())) { throw std::invalid_argument("input_grammar: unsupported native object constraint " + item.key()); }
+        }
+        if (schema.contains("additionalProperties") && !schema.at("additionalProperties").is_boolean()) {
+            throw std::invalid_argument("input_grammar: native additional property schemas are unsupported");
+        }
+        for (const auto & name : schema.value("required", json::array())) {
+            if (!name.is_string() || !schema.at("properties").contains(name.get<std::string>())) {
+                throw std::invalid_argument("input_grammar: missing required native property");
+            }
+        }
+        for (const auto & property : schema.at("properties").items()) {
+            if (property.key().empty() || std::isspace(static_cast<unsigned char>(property.key().front())) ||
+                std::isspace(static_cast<unsigned char>(property.key().back()))) {
+                throw std::invalid_argument("input_grammar: native mapper cannot preserve surrounding whitespace in property names");
+            }
+        }
+    }
+
+    bool concatenated_arguments(id node, std::set<id> & seen) const {
+        if (!seen.insert(node).second) { return true; }
+        const auto & value = source.get(node);
+        if (auto tag = std::get_if<common_peg_tag_parser>(&value); tag && tag->tag == common_chat_peg_builder::TOOL_ARG) { return true; }
+        if (auto lit = std::get_if<common_peg_literal_parser>(&value)) { return lit->literal.empty(); }
+        if (std::holds_alternative<common_peg_epsilon_parser>(value) || std::holds_alternative<common_peg_space_parser>(value)) { return true; }
+        const auto child_nodes = children(value);
+        if (child_nodes.empty()) { return false; }
+        for (auto child : child_nodes) { if (!concatenated_arguments(child, seen)) { return false; } }
+        return true;
+    }
+
+    id native_value(const json & schema, context ctx, size_t depth = 0) {
+        if (depth > 64) { throw std::invalid_argument("input_grammar: native schema exceeds depth budget"); }
+        const auto type = schema.value("type", "");
+        if (type == "string") {
+            const auto & codec = source.value_codecs_.at("string");
+            auto stop = literal(codec.close);
+            if (stop.empty()) { throw std::invalid_argument("input_grammar: native string delimiter is not literal"); }
+            json definition;
+            if (bodies.count(ctx.tool) && ctx.argument == "input") { definition["lark_grammar"] = bodies.at(ctx.tool); }
+            else { definition["json_schema"] = schema; }
+            definition["tool_input_mode"] = "raw";
+            definition["tool_input_stop"] = stop;
+            if (!raw_encoding_is_lossless(definition, ctx)) { return COMMON_PEG_INVALID_PARSER_ID; }
+            auto body = output.get_rule(external_rule(std::move(definition)));
+            if (bodies.count(ctx.tool)) { bound.insert(ctx.tool); }
+            return sequence({codec.open, body, codec.close});
+        }
+        if (type == "object") {
+            require_object(schema);
+            const auto & codec = source.value_codecs_.at("object");
+            std::set<std::string> required;
+            for (const auto & name : schema.value("required", json::array())) { required.insert(name.get<std::string>()); }
+            for (const auto & name : required) {
+                if (!schema.at("properties").contains(name)) { throw std::invalid_argument("input_grammar: missing required native property"); }
+            }
+            std::vector<id> members;
+            std::vector<bool> mandatory;
+            for (const auto & property : schema.at("properties").items()) {
+                common_peg_parse_context key_input(property.key());
+                key_input.rule_depth.assign(source.size(), 0);
+                auto key_result = source.parse(codec.key, key_input, 0);
+                if (!key_result.success() || key_result.end != property.key().size()) {
+                    throw std::invalid_argument("input_grammar: native codec cannot represent property " + property.key());
+                }
+                auto nested = ctx; nested.argument = property.key();
+                auto value = native_value(property.value(), nested, depth + 1);
+                if (value == COMMON_PEG_INVALID_PARSER_ID) { return value; }
+                members.push_back(sequence({output.add_parser(common_peg_literal_parser{property.key()}), codec.key_end, value}));
+                mandatory.push_back(required.count(property.key()) != 0);
+            }
+            auto after = output.add_parser(common_peg_epsilon_parser{}), first = after;
+            for (size_t i = members.size(); i-- > 0;) {
+                auto separated = sequence({codec.separator, members[i], after});
+                auto initial = sequence({members[i], after});
+                after = mandatory[i] ? separated : output.add_parser(common_peg_choice_parser{{separated, after}});
+                first = mandatory[i] ? initial : output.add_parser(common_peg_choice_parser{{initial, first}});
+            }
+            return sequence({codec.open, first, codec.close});
+        }
+        if (type == "array") {
+            static const std::set<std::string> supported = {"type", "items", "minItems", "maxItems", "title", "description"};
+            for (const auto & item : schema.items()) {
+                if (!supported.count(item.key())) { throw std::invalid_argument("input_grammar: unsupported native array constraint " + item.key()); }
+            }
+            const auto & codec = source.value_codecs_.at("array");
+            auto item = native_value(schema.at("items"), ctx, depth + 1);
+            if (item == COMMON_PEG_INVALID_PARSER_ID) { return item; }
+            const int min = schema.value("minItems", 0), max = schema.value("maxItems", -1);
+            if (min < 0 || min > 1024 || (max != -1 && (max < min || max > 1024))) {
+                throw std::invalid_argument("input_grammar: native array count exceeds budget");
+            }
+            auto content = output.add_parser(common_peg_epsilon_parser{});
+            if (max != 0) {
+                auto tail = output.add_parser(common_peg_repetition_parser{sequence({codec.separator, item}), std::max(0, min - 1), max == -1 ? -1 : max - 1});
+                auto nonempty = sequence({item, tail});
+                content = min ? nonempty : output.add_parser(common_peg_choice_parser{{nonempty, content}});
+            }
+            return sequence({codec.open, content, codec.close});
+        }
+        if (type == "number" || type == "integer" || type == "boolean" || type == "null") {
+            return output.get_rule(external_rule({{"json_schema", schema}}));
+        }
+        throw std::invalid_argument("input_grammar: unsupported native value schema");
+    }
+
+    std::vector<std::string> marker_words(id node, size_t depth = 0) const {
+        if (depth > 64) { throw std::invalid_argument("input_grammar: recursive native prefix marker"); }
+        return std::visit([&](const auto & p) -> std::vector<std::string> {
+            using T = std::decay_t<decltype(p)>;
+            if constexpr (std::is_same_v<T, common_peg_literal_parser>) { return {p.literal}; }
+            else if constexpr (std::is_same_v<T, common_peg_epsilon_parser>) { return {""}; }
+            else if constexpr (std::is_same_v<T, common_peg_until_parser>) { return p.delimiters; }
+            else if constexpr (std::is_same_v<T, common_peg_rule_parser> || std::is_same_v<T, common_peg_atomic_parser> ||
+                std::is_same_v<T, common_peg_tag_parser>) { return marker_words(p.child, depth + 1); }
+            else if constexpr (std::is_same_v<T, common_peg_ref_parser>) { return marker_words(source.get_rule(p.name), depth + 1); }
+            else if constexpr (std::is_same_v<T, common_peg_repetition_parser>) {
+                if (p.min_count != 0 || p.max_count != 1) { throw std::invalid_argument("input_grammar: native prefix marker is not finite"); }
+                auto words = marker_words(p.child, depth + 1);
+                words.insert(words.begin(), "");
+                return words;
+            } else if constexpr (std::is_same_v<T, common_peg_sequence_parser>) {
+                std::vector<std::string> words{""};
+                for (auto child : p.children) {
+                    std::vector<std::string> joined;
+                    for (const auto & prefix : words) {
+                        for (const auto & suffix : marker_words(child, depth + 1)) {
+                            if (joined.size() >= 128 || prefix.size() + suffix.size() > 4096) { throw std::invalid_argument("input_grammar: native prefix marker exceeds budget"); }
+                            joined.push_back(prefix + suffix);
+                        }
+                    }
+                    words = std::move(joined);
+                }
+                return words;
+            } else if constexpr (std::is_same_v<T, common_peg_choice_parser>) {
+                std::vector<std::string> words;
+                for (auto child : p.children) {
+                    auto part = marker_words(child, depth + 1);
+                    words.insert(words.end(), part.begin(), part.end());
+                }
+                return words;
+            }
+            throw std::invalid_argument("input_grammar: native prefix marker is not a literal language");
+        }, source.get(node));
+    }
+
+    static std::string regular_prefix(const std::vector<prefix_arc> & arcs, size_t state_count,
+                                      const std::vector<size_t> & accepting) {
+        const size_t missing = static_cast<size_t>(-1);
+        std::vector<std::string> expressions{"\"\""};
+        std::map<std::string, size_t> interned{{"\"\"", 0}};
+        auto expression = [&](std::string text) {
+            if (auto found = interned.find(text); found != interned.end()) { return found->second; }
+            if (expressions.size() >= 100000) { throw std::invalid_argument("input_grammar: prefix regex exceeds compilation budget"); }
+            auto index = expressions.size();
+            interned[text] = index;
+            expressions.push_back(std::move(text));
+            return index;
+        };
+        auto name = [](size_t index) { return "PFX" + std::to_string(index); };
+        auto concatenate = [&](size_t left, size_t right) {
+            if (left == missing || right == missing) { return missing; }
+            if (left == 0) { return right; }
+            if (right == 0) { return left; }
+            return expression(name(left) + " " + name(right));
+        };
+        auto alternate = [&](size_t left, size_t right) {
+            if (left == missing) { return right; }
+            if (right == missing || left == right) { return left; }
+            if (left > right) { std::swap(left, right); }
+            return expression(name(left) + " | " + name(right));
+        };
+        const size_t start = state_count;
+        size_t node_count = state_count + 1;
+        std::map<std::string, size_t> ends;
+        if (!accepting.empty()) { ends[""] = node_count++; }
+        for (const auto & arc : arcs) {
+            if (arc.target.front() == 'r' && !ends.count(arc.target)) { ends[arc.target] = node_count++; }
+        }
+        std::vector<std::map<size_t, size_t>> outgoing(node_count);
+        std::vector<std::set<size_t>> incoming(node_count);
+        auto add_edge = [&](size_t from, size_t to, size_t rx) {
+            auto found = outgoing[from].find(to);
+            outgoing[from][to] = alternate(found == outgoing[from].end() ? missing : found->second, rx);
+            incoming[to].insert(from);
+        };
+        add_edge(start, 0, 0);
+        for (auto state : accepting) { add_edge(state, ends.at(""), 0); }
+        for (const auto & arc : arcs) {
+            const size_t target = arc.target.front() == 'p' ? std::stoul(arc.target.substr(1)) : ends.at(arc.target);
+            add_edge(arc.from, target, expression(arc.pattern));
+        }
+        // Eliminate DFA states into a shared regex DAG, not per-byte Earley rules.
+        std::set<size_t> remaining;
+        for (size_t i = 0; i < state_count; ++i) { remaining.insert(i); }
+        while (!remaining.empty()) {
+            size_t selected = *remaining.begin(), best = missing;
+            for (auto node : remaining) {
+                const size_t self = outgoing[node].count(node);
+                const size_t score = (incoming[node].size() - self) * (outgoing[node].size() - self);
+                if (score < best) { best = score; selected = node; }
+            }
+            const auto in = incoming[selected];
+            const auto out = outgoing[selected];
+            const auto self = out.find(selected);
+            const size_t loop = self == out.end() || self->second == 0 ? 0 : expression(name(self->second) + "*");
+            for (auto from : in) {
+                if (from == selected) { continue; }
+                const auto head = concatenate(outgoing[from].at(selected), loop);
+                for (const auto & [to, tail] : out) {
+                    if (to != selected) { add_edge(from, to, concatenate(head, tail)); }
+                }
+            }
+            for (auto from : in) { if (from != selected) { outgoing[from].erase(selected); } }
+            for (const auto & [to, unused] : out) { (void) unused; if (to != selected) { incoming[to].erase(selected); } }
+            incoming[selected].clear();
+            outgoing[selected].clear();
+            remaining.erase(selected);
+        }
+        std::string lark;
+        for (size_t i = 0; i < expressions.size(); ++i) { lark += name(i) + ": " + expressions[i] + "\n"; }
+        lark += "start: ";
+        bool first = true;
+        for (const auto & [suffix, sink] : ends) {
+            auto edge = outgoing[start].find(sink);
+            if (edge == outgoing[start].end()) { continue; }
+            lark += (first ? "" : " | ") + name(edge->second) + (suffix.empty() ? "" : " " + suffix);
+            first = false;
+        }
+        if (first) { throw std::invalid_argument("input_grammar: native prefix has no accepting path"); }
+        return lark + "\n";
+    }
+
+    std::string prefix_language(llama_grammar_parser & parsed, const std::map<uint32_t, std::string> & external_ids) const {
+        using symbols = std::vector<uint32_t>;
+        using state_key = std::pair<size_t, symbols>;
+        struct edge { symbols word; size_t next; bool replay; bool tool; };
+        struct transition { bool valid; bool tool; state_key state; symbols marker; };
+        if (source.prefix_states_.empty() || source.prefix_root_ >= source.prefix_states_.size()) {
+            throw std::invalid_argument("input_grammar: native parser has no prefix control binding");
+        }
+        std::vector<std::vector<edge>> edges(source.prefix_states_.size());
+        std::set<uint32_t> alphabet;
+        for (size_t i = 0; i < edges.size(); ++i) {
+            if (source.prefix_states_[i].whitespace) { alphabet.insert({' ', '\t', '\n', '\r', '\f', '\v'}); }
+            for (const auto & item : source.prefix_states_[i].edges) {
+                for (const auto & word : marker_words(item.marker)) {
+                    auto cps = unicode_cpts_from_utf8(word);
+                    if (item.tool && cps.empty()) { throw std::invalid_argument("input_grammar: empty native tool entry"); }
+                    alphabet.insert(cps.begin(), cps.end());
+                    edges[i].push_back({std::move(cps), item.next, item.replay, item.tool});
+                }
+            }
+        }
+        if (edges.size() > 128 || alphabet.size() > 512) { throw std::invalid_argument("input_grammar: native prefix controls exceed budget"); }
+        auto normalize = [&](state_key key) -> transition {
+            for (size_t steps = 0; steps < 16384; ++steps) {
+                const auto & state = source.prefix_states_.at(key.first);
+                bool partial = false, moved = false;
+                for (const auto & item : edges.at(key.first)) {
+                    const size_t common = std::min(item.word.size(), key.second.size());
+                    if (!std::equal(item.word.begin(), item.word.begin() + common, key.second.begin())) { continue; }
+                    if (key.second.size() < item.word.size()) { partial = true; continue; }
+                    if (item.tool) {
+                        if (key.second.size() != item.word.size()) {
+                            throw std::invalid_argument("input_grammar: prefix lookahead extends past native tool entry");
+                        }
+                        return {true, true, {}, item.word};
+                    }
+                    key.first = item.next;
+                    if (!item.replay) { key.second.erase(key.second.begin(), key.second.begin() + item.word.size()); }
+                    moved = true;
+                    break;
+                }
+                if (moved) { continue; }
+                if (partial || key.second.empty()) { return {true, false, std::move(key), {}}; }
+                if (state.whitespace && key.second.front() < 128 && std::isspace(static_cast<unsigned char>(key.second.front()))) {
+                    key.second.erase(key.second.begin());
+                    continue;
+                }
+                if (state.fallback != COMMON_PEG_INVALID_PARSER_ID) { key.first = state.fallback; continue; }
+                if (!state.scan) { return {false, false, {}, {}}; }
+                key.second.erase(key.second.begin());
+            }
+            throw std::invalid_argument("input_grammar: native prefix control cycle");
+        };
+        auto can_end = [&](state_key key) {
+            std::set<size_t> seen;
+            while (seen.insert(key.first).second) {
+                const auto & state = source.prefix_states_.at(key.first);
+                if (state.complete && (state.scan || key.second.empty())) { return true; }
+                if (!key.second.empty() || state.fallback == COMMON_PEG_INVALID_PARSER_ID) { return false; }
+                key.first = state.fallback;
+            }
+            return false;
+        };
+        std::map<symbols, uint32_t> suffix_rules;
+        auto suffix_rule = [&](const symbols & marker) {
+            if (auto found = suffix_rules.find(marker); found != suffix_rules.end()) { return found->second; }
+            auto c_rules = parsed.c_rules();
+            std::unique_ptr<llama_grammar, decltype(&llama_grammar_free_impl)> grammar(
+                llama_grammar_init_impl(nullptr, c_rules.data(), c_rules.size(), parsed.symbol_ids.at("root")), llama_grammar_free_impl);
+            if (!grammar) { throw std::invalid_argument("input_grammar: cannot derive native tool entry"); }
+            for (auto cp : marker) { llama_grammar_accept_str(*grammar, unicode_cpt_to_utf8(cp)); }
+            const auto & stacks = llama_grammar_get_stacks(grammar.get());
+            if (stacks.empty()) { throw std::invalid_argument("input_grammar: native tool marker does not match its grammar"); }
+            std::map<const llama_grammar_element *, std::pair<uint32_t, size_t>> positions;
+            const auto & rules = llama_grammar_get_rules(grammar.get());
+            for (uint32_t i = 0; i < rules.size(); ++i) {
+                for (size_t j = 0; j < rules[i].size(); ++j) { positions[&rules[i][j]] = {i, j}; }
+            }
+            llama_grammar_rule derivative;
+            for (const auto & stack : stacks) {
+                if (!derivative.empty()) { derivative.push_back({LLAMA_GRETYPE_ALT, 0}); }
+                for (auto entry = stack.rbegin(); entry != stack.rend(); ++entry) {
+                    const auto [rule_id, offset] = positions.at(*entry);
+                    if (external_ids.count(rule_id)) {
+                        if (offset != 0) { throw std::invalid_argument("input_grammar: native trigger enters a body grammar"); }
+                        derivative.push_back({LLAMA_GRETYPE_RULE_REF, rule_id});
+                        continue;
+                    }
+                    for (size_t pos = offset; pos < rules[rule_id].size(); ++pos) {
+                        auto element = rules[rule_id][pos];
+                        if (element.type == LLAMA_GRETYPE_ALT || element.type == LLAMA_GRETYPE_END) { break; }
+                        derivative.push_back(element);
+                    }
+                }
+            }
+            derivative.push_back({LLAMA_GRETYPE_END, 0});
+            auto id = static_cast<uint32_t>(parsed.rules.size());
+            parsed.rules.push_back(std::move(derivative));
+            suffix_rules[marker] = id;
+            return id;
+        };
+        auto start = normalize({source.prefix_root_, {}});
+        if (!start.valid || start.tool) { throw std::invalid_argument("input_grammar: invalid native prefix start"); }
+        std::vector<state_key> states{start.state};
+        std::map<state_key, size_t> ids{{start.state, 0}};
+        uint32_t other = 0x10ffff;
+        while (alphabet.count(other)) { --other; }
+        std::vector<uint32_t> characters(alphabet.begin(), alphabet.end());
+        characters.push_back(other);
+        std::vector<prefix_arc> arcs;
+        std::vector<size_t> accepting;
+        for (size_t index = 0; index < states.size(); ++index) {
+            if (states.size() > 4096) { throw std::invalid_argument("input_grammar: native prefix DFA exceeds budget"); }
+            const auto current = states[index];
+            std::map<std::string, std::vector<uint32_t>> targets;
+            for (auto cp : characters) {
+                auto next_key = current;
+                next_key.second.push_back(cp);
+                auto next = normalize(std::move(next_key));
+                if (!next.valid) { continue; }
+                std::string target;
+                if (next.tool) { target = "r" + std::to_string(suffix_rule(next.marker)); }
+                else {
+                    auto found = ids.find(next.state);
+                    if (found == ids.end()) {
+                        auto id = states.size();
+                        states.push_back(next.state);
+                        found = ids.emplace(next.state, id).first;
+                    }
+                    target = "p" + std::to_string(found->second);
+                }
+                targets[target].push_back(cp);
+            }
+            if (allow_plain && can_end(current)) { accepting.push_back(index); }
+            for (const auto & target : targets) {
+                const bool has_other = std::find(target.second.begin(), target.second.end(), other) != target.second.end();
+                std::string pattern = has_other ? "/[^" : "/[";
+                if (has_other) {
+                    for (auto cp : alphabet) {
+                        if (std::find(target.second.begin(), target.second.end(), cp) == target.second.end()) { pattern += codepoint(cp); }
+                    }
+                } else { for (auto cp : target.second) { pattern += codepoint(cp); } }
+                if (pattern == "/[^") { pattern = "/(?s:.)/"; }
+                else { pattern += "]/"; }
+                arcs.push_back({index, target.first, std::move(pattern)});
+            }
+            if (targets.empty() && !(allow_plain && can_end(current))) { throw std::invalid_argument("input_grammar: native prefix has a dead state"); }
+        }
+        return regular_prefix(arcs, states.size(), accepting);
+    }
+
+    result compile(id node, context ctx = {}, size_t depth = 0) {
+        if (++visits > 50000 || depth > 128) { throw std::invalid_argument("input_grammar: native graph expansion exceeds budget"); }
+        if (ctx.tool.empty()) {
+            auto tools = names(node, common_chat_peg_builder::TOOL_NAME);
+            if (tools.size() == 1) {
+                if (!parameters.count(*tools.begin())) { throw std::invalid_argument("input_grammar: unknown native tool branch"); }
+                ctx.tool = *tools.begin();
+            }
+        }
+        const auto key = std::make_tuple(node, ctx.tool, ctx.argument, ctx.forbidden_prefixes);
+        if (auto found = cache.find(key); found != cache.end()) { return found->second; }
+        cache[key] = {node, false};
+        const auto & value = source.get(node);
+        auto node_tag = std::get_if<common_peg_tag_parser>(&value);
+        auto semantic = source.semantics_.find(node);
+        const bool args_container = (node_tag && node_tag->tag == common_chat_peg_builder::TOOL_ARGS) ||
+            (semantic != source.semantics_.end() && semantic->second == common_chat_peg_builder::TOOL_ARGS);
+        if (args_container && !ctx.tool.empty() && !names(node, common_chat_peg_builder::TOOL_ARG_NAME).empty()) {
+            const auto & schema = parameters.at(ctx.tool);
+            require_object(schema);
+            std::set<id> seen;
+            if (!concatenated_arguments(node, seen)) { throw std::invalid_argument("input_grammar: native argument separators need a codec binding"); }
+            std::map<std::string, id> arguments;
+            for (auto child : descendants(node)) {
+                if (auto tag = std::get_if<common_peg_tag_parser>(&source.get(child)); tag && tag->tag == common_chat_peg_builder::TOOL_ARG) {
+                    auto keys = names(child, common_chat_peg_builder::TOOL_ARG_NAME);
+                    if (keys.size() != 1) { throw std::invalid_argument("input_grammar: ambiguous native parameter binding"); }
+                    arguments.emplace(*keys.begin(), child);
+                }
+            }
+            std::set<std::string> required;
+            for (const auto & name : schema.value("required", json::array())) { required.insert(name.get<std::string>()); }
+            std::vector<id> members, optional_members;
+            for (const auto & property : schema.at("properties").items()) {
+                auto argument = arguments.find(property.key());
+                if (argument == arguments.end()) { throw std::invalid_argument("input_grammar: native parameter is missing"); }
+                auto value = compile(argument->second, ctx, depth + 1);
+                if (value.node == COMMON_PEG_INVALID_PARSER_ID) { return cache[key] = value; }
+                if (required.count(property.key())) { members.push_back(value.node); }
+                else { optional_members.push_back(output.add_parser(common_peg_repetition_parser{value.node, 0, 1})); }
+            }
+            members.insert(members.end(), optional_members.begin(), optional_members.end());
+            validated_tools.insert(ctx.tool);
+            return cache[key] = {sequence(std::move(members)), true};
+        }
+        if (auto tag = std::get_if<common_peg_tag_parser>(&value); tag && !ctx.tool.empty()) {
+            if (tag->tag == common_chat_peg_builder::TOOL_ARG) {
+                auto args = names(node, common_chat_peg_builder::TOOL_ARG_NAME);
+                if (args.size() != 1 || !parameters.at(ctx.tool).at("properties").contains(*args.begin())) { throw std::invalid_argument("input_grammar: cannot bind native argument"); }
+                ctx.argument = *args.begin();
+            }
+            if (tag->tag == common_chat_peg_builder::TOOL_ARGS && names(node, common_chat_peg_builder::TOOL_ARG_NAME).empty()) {
+                if (auto codec = source.value_codecs_.find("object"); codec != source.value_codecs_.end()) {
+                    auto nodes = descendants(tag->child);
+                    if (std::find(nodes.begin(), nodes.end(), codec->second.value) != nodes.end()) {
+                        auto rewritten = native_value(parameters.at(ctx.tool), ctx);
+                        if (rewritten != COMMON_PEG_INVALID_PARSER_ID) { validated_tools.insert(ctx.tool); }
+                        return cache[key] = {rewritten, true};
+                    }
+                }
+                bool json_args = false;
+                for (auto child : descendants(tag->child)) {
+                    if (auto schema = std::get_if<common_peg_schema_parser>(&source.get(child)); schema && !schema->raw) { json_args = true; break; }
+                }
+                if (!json_args) {
+                    const auto & schema = parameters.at(ctx.tool);
+                    if (!bodies.count(ctx.tool) && (schema.empty() ||
+                        (schema.value("type", "") == "object" && schema.value("properties", json::object()).empty() &&
+                         schema.value("required", json::array()).empty()))) {
+                        if (!schema.empty()) { require_object(schema); }
+                        common_peg_parse_context empty_input("");
+                        empty_input.rule_depth.assign(source.size(), 0);
+                        if (source.parse(tag->child, empty_input, 0).success()) {
+                            validated_tools.insert(ctx.tool);
+                            return cache[key] = {node, false};
+                        }
+                    }
+                    throw std::invalid_argument("input_grammar: native argument codec has no semantic binding");
+                }
+                if (!bodies.count(ctx.tool)) {
+                    auto body = external_rule({{"json_schema", parameters.at(ctx.tool)}});
+                    validated_tools.insert(ctx.tool);
+                    return cache[key] = {output.get_rule(body), true};
+                }
+                auto body = external_rule({{"lark_grammar", bodies.at(ctx.tool)}, {"tool_input_mode", "json_string"}});
+                auto name = "native-args-" + std::to_string(output.size());
+                auto rewritten = rule(name, "\"{\\\"input\\\":\\\"\" " + body + " \"\\\"}\"", output.get_rule(body));
+                bound.insert(ctx.tool);
+                validated_tools.insert(ctx.tool);
+                return cache[key] = {rewritten, true};
+            }
+            if (tag->tag == common_chat_peg_builder::TOOL_ARG_STRING_VALUE) {
+                if (ctx.argument.empty() || (bodies.count(ctx.tool) && ctx.argument != "input")) { throw std::invalid_argument("input_grammar: native string is not bound to a parameter"); }
+                std::set<std::string> stops;
+                for (auto child : descendants(tag->child)) {
+                    if (auto until = std::get_if<common_peg_until_parser>(&source.get(child))) {
+                        stops.insert(until->delimiters.begin(), until->delimiters.end());
+                    }
+                }
+                if (stops.size() != 1) { throw std::invalid_argument("input_grammar: native raw string needs one explicit delimiter"); }
+                json definition = {{"tool_input_mode", "raw"}, {"tool_input_stop", *stops.begin()}};
+                if (bodies.count(ctx.tool)) { definition["lark_grammar"] = bodies.at(ctx.tool); }
+                else { definition["json_schema"] = parameters.at(ctx.tool).at("properties").at(ctx.argument); }
+                if (!raw_encoding_is_lossless(definition, ctx)) { return cache[key] = {COMMON_PEG_INVALID_PARSER_ID, true}; }
+                auto name = external_rule(std::move(definition));
+                if (bodies.count(ctx.tool)) { bound.insert(ctx.tool); }
+                return cache[key] = {output.get_rule(name), true};
+            }
+            if (tag->tag == common_chat_peg_builder::TOOL_ARG_VALUE && !ctx.argument.empty()) {
+                bool json_value = false;
+                for (auto child : descendants(tag->child)) {
+                    if (auto schema = std::get_if<common_peg_schema_parser>(&source.get(child)); schema && !schema->raw) { json_value = true; }
+                }
+                if (!json_value) { throw std::invalid_argument("input_grammar: native value codec has no JSON binding"); }
+                auto name = external_rule({{"json_schema", parameters.at(ctx.tool).at("properties").at(ctx.argument)}});
+                return cache[key] = {output.get_rule(name), true};
+            }
+        }
+        result transformed = {node, false};
+        auto replacement = value;
+        bool failed = false;
+        std::visit([&](auto & p) {
+            using T = std::decay_t<decltype(p)>;
+            if constexpr (std::is_same_v<T, common_peg_sequence_parser> || std::is_same_v<T, common_peg_choice_parser>) {
+                std::vector<id> child_nodes;
+                auto next_context = ctx;
+                for (auto child : p.children) {
+                    if constexpr (std::is_same_v<T, common_peg_sequence_parser>) {
+                        if (auto negative = std::get_if<common_peg_not_parser>(&source.get(child))) {
+                            auto prefix = literal(negative->child);
+                            if (!prefix.empty()) { next_context.forbidden_prefixes.push_back(prefix); }
+                        }
+                    }
+                    auto next = compile(child, next_context, depth + 1);
+                    transformed.changed |= next.changed;
+                    if (next.node == COMMON_PEG_INVALID_PARSER_ID) {
+                        if constexpr (std::is_same_v<T, common_peg_sequence_parser>) { failed = true; }
+                    } else { child_nodes.push_back(next.node); }
+                }
+                if (child_nodes.empty() && !p.children.empty()) { failed = true; }
+                p.children = std::move(child_nodes);
