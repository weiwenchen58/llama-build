+    }
+    compiler.output.set_root(root.node);
+    std::set<common_peg_parser_id> reachable, entries;
+    std::vector<common_peg_parser_id> pending{root.node};
+    while (!pending.empty()) {
+        auto node = pending.back(); pending.pop_back();
+        if (!reachable.insert(node).second) { continue; }
+        if (auto rule = std::get_if<common_peg_rule_parser>(&compiler.output.get(node)); rule && rule->trigger) {
+            entries.insert(node);
+            continue;
+        }
+        auto child_nodes = common_chat_tool_grammar::children(compiler.output.get(node));
+        pending.insert(pending.end(), child_nodes.begin(), child_nodes.end());
+    }
+    for (size_t node = 0; node < compiler.output.size(); ++node) {
+        if (auto rule = std::get_if<common_peg_rule_parser>(&compiler.output.get(node)); rule && !entries.count(node)) {
+            rule->trigger = false;
+        }
+    }
+    auto gbnf = build_grammar([&](const common_grammar_builder & builder) { compiler.output.build_grammar(builder, true); });
+    llama_grammar_parser parsed;
+    if (!parsed.parse(gbnf.c_str())) { throw std::invalid_argument("input_grammar: invalid native sampling grammar"); }
+    json grammars = json::array({json::object()});
+    std::map<uint32_t, std::string> replacements;
+    for (auto & entry : compiler.external) {
+        auto symbol = parsed.symbol_ids.find(entry.first);
+        if (symbol == parsed.symbol_ids.end()) { continue; }
+        auto name = "body" + std::to_string(grammars.size());
+        replacements[symbol->second] = "@" + name;
+        entry.second["name"] = name;
+        grammars.push_back(std::move(entry.second));
+    }
+    auto prefix = compiler.prefix_language(parsed, replacements);
+    grammars[0] = {{"name", "native"}, {"lark_grammar", emit_lark(parsed, "r", replacements) + prefix}};
+    for (size_t node = 0; node < data.parser.size(); ++node) {
+        if (auto literal = std::get_if<common_peg_literal_parser>(&data.parser.get(node)); literal && !literal->literal.empty()) {
+            data.preserved_tokens.push_back(literal->literal);
+        }
+    }
+    std::sort(data.preserved_tokens.begin(), data.preserved_tokens.end());
+    data.preserved_tokens.erase(std::unique(data.preserved_tokens.begin(), data.preserved_tokens.end()), data.preserved_tokens.end());
+    auto tokens = data.preserved_tokens;
+    tokens.push_back(data.generation_prompt);
+    data.grammar = "%llguidance-json\n" + json{{"grammars", grammars}, {"native_tokens", tokens}}.dump();
+    data.grammar_lazy = false;
+    data.grammar_triggers.clear();
+    data.strict_tool_grammar = true;
+    data.grammar_requires_tool = inputs.tool_choice == COMMON_CHAT_TOOL_CHOICE_REQUIRED;
+    data.grammar_allows_parallel = inputs.parallel_tool_calls;
+}
