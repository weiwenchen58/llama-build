diff --git a/common/chat-tool-grammar.cpp b/common/chat-tool-grammar.cpp
new file mode 100644
index 0000000..107cf66
--- /dev/null
+++ b/common/chat-tool-grammar.cpp
@@ -0,0 +1,316 @@
+#include "chat-peg-parser.h"
+#include "chat-auto-parser.h"
+#include "parsers/parsers.h"
+#include "json-schema-to-grammar.h"
+#include "../src/llama-grammar.h"
+#include <cstdio>
+#include <set>
+
+using json = common_json;
+
+static std::string codepoint(uint32_t value) {
+    char buffer[20];
+    snprintf(buffer, sizeof(buffer), "\\x{%x}", value);
+    return buffer;
+}
+
+// Reuse llama.cpp's GBNF parser, including its lowering of repetitions to rules.
+// Translate parsed elements, never splice or regex-edit the generated grammar text.
+static std::string emit_lark(const llama_grammar_parser & parsed, const std::string & prefix,
+                             const std::map<uint32_t, std::string> & bodies = {}) {
+    std::string result;
+    for (size_t i = 0; i < parsed.rules.size(); ++i) {
+        result += prefix + std::to_string(i) + ": ";
+        auto body = bodies.find(i);
+        if (body != bodies.end()) {
+            result += body->second + "\n";
+            continue;
+        }
+        const auto & rule = parsed.rules[i];
+        for (size_t j = 0; j < rule.size(); ++j) {
+            const auto & elem = rule[j];
+            switch (elem.type) {
+                case LLAMA_GRETYPE_END: break;
+                case LLAMA_GRETYPE_ALT: result += " | "; break;
+                case LLAMA_GRETYPE_RULE_REF: result += prefix + std::to_string(elem.value) + " "; break;
+                case LLAMA_GRETYPE_CHAR_ANY: result += "/(?s:.)/ "; break;
+                case LLAMA_GRETYPE_CHAR:
+                case LLAMA_GRETYPE_CHAR_NOT: {
+                    result += elem.type == LLAMA_GRETYPE_CHAR_NOT ? "/[^" : "/[";
+                    result += codepoint(elem.value);
+                    while (j + 1 < rule.size()) {
+                        const auto & next = rule[j + 1];
+                        if (next.type == LLAMA_GRETYPE_CHAR_RNG_UPPER) {
+                            result += "-" + codepoint(next.value);
+                        } else if (next.type == LLAMA_GRETYPE_CHAR_ALT) {
+                            result += codepoint(next.value);
+                        } else {
+                            break;
+                        }
+                        ++j;
+                    }
+                    result += "]/ ";
+                    break;
+                }
+                default: throw std::invalid_argument("input_grammar: unsupported native grammar terminal");
+            }
+        }
+        result += "\n";
+    }
+    return result;
+}
+
+namespace {
+// The descriptor is data, never executable source. The same tree supplies the
+// response parser and the outer constraint; only body/schema leaves use LLG.
+struct format_compiler {
+    common_chat_peg_builder & p;
+    const common_chat_templates_inputs & inputs;
+    const json & spec;
+    const std::string & prefill;
+    std::map<std::string, json> external;
+    std::set<std::string> bound;
+    const common_chat_tool * tool = nullptr;
+    json property;
+    std::string property_name;
+    size_t nodes = 0;
+
+    void require(bool ok, const std::string & message) {
+        if (!ok) { throw std::invalid_argument("native_tool_format: " + message); }
+    }
+
+    common_peg_parser leaf(const common_peg_parser & parser, json grammar) {
+        const std::string name = "external-" + std::to_string(external.size());
+        external.emplace(name, std::move(grammar));
+        return p.rule(name, p.gbnf(parser, "\"\""));
+    }
+
+    common_peg_parser emit(const std::string & text) {
+        return p.tag("runtime-emit:" + text, p.eps());
+    }
+
+    common_peg_parser value(const json & schema, const std::string & encoding, const std::string & stop) {
+        if (encoding == "json") {
+            return leaf(p.tag("runtime-json", p.json()), {{"json_schema", schema}});
+        }
+        require(encoding == "raw" && !stop.empty(), "raw values require a closing delimiter");
+        return leaf(p.tag("runtime-string", p.until(stop)),
+            {{"json_schema", schema}, {"tool_input_mode", "raw"}, {"tool_input_stop", stop}});
+    }
+
+    bool condition(const std::string & name) {
+        if (name == "required") { return inputs.tool_choice == COMMON_CHAT_TOOL_CHOICE_REQUIRED; }
+        if (name == "parallel") { return inputs.parallel_tool_calls; }
+        if (name == "thinking") { return inputs.enable_thinking; }
+        if (name == "thinking_prefilled") {
+            const auto start = spec.value("thinking_start", "");
+            return inputs.enable_thinking && !start.empty() && prefill.find(start) != std::string::npos;
+        }
+        if (name == "tools") { return !inputs.tools.empty() && inputs.tool_choice != COMMON_CHAT_TOOL_CHOICE_NONE; }
+        if (name == "input_grammar") { require(tool, "input_grammar condition outside tools"); return !tool->input_grammar.empty(); }
+        if (name == "string") { require(!property.is_null(), "string condition outside parameters"); return property.value("type", "") == "string"; }
+        throw std::invalid_argument("native_tool_format: unknown condition " + name);
+    }
+
+    common_peg_parser compile(const json & node, size_t depth = 0) {
+        require(depth < 64 && ++nodes <= 10000, "descriptor expansion exceeds budget");
+        if (node.is_string()) { return p.literal(node.get<std::string>()); }
+        if (node.is_array()) {
+            std::vector<common_peg_parser> parts;
+            for (const auto & child : node) { parts.push_back(compile(child, depth + 1)); }
+            return p.sequence(parts);
+        }
+        require(node.is_object(), "a node must be a literal, sequence or operation");
+        const auto op = node.at("op").get<std::string>();
+        auto child = [&]() { return compile(node.at("item"), depth + 1); };
+        if (op == "ref") { return compile(spec.at("definitions").at(node.at("name").get<std::string>()), depth + 1); }
+        if (op == "if") { return compile(node.at(condition(node.at("condition")) ? "then" : "else"), depth + 1); }
+        if (op == "choice") {
+            std::vector<common_peg_parser> alternatives;
+            for (const auto & item : node.at("items")) { alternatives.push_back(compile(item, depth + 1)); }
+            require(!alternatives.empty(), "empty choice");
+            return p.choice(alternatives);
+        }
+        if (op == "repeat") {
+            const int min = node.value("min", 0), max = node.value("max", -1);
+            require(min >= 0 && min <= 100 && (max == -1 || (max >= min && max <= 100)), "invalid repetition");
+            return p.repeat(child(), min, max);
+        }
+        if (op == "space") { return p.space(); }
+        if (op == "until") {
+            const auto stops = node.at("stops").get<std::vector<std::string>>();
+            for (const auto & stop : stops) { require(!stop.empty(), "empty delimiter"); }
+            return p.until_one_of(stops);
+        }
+        if (op == "content" || op == "reasoning") { return p.tag(op, child()); }
+        if (op == "emit") { return emit(node.at("value")); }
+        if (op == "tools") {
+            require(!tool, "nested tools expansion");
+            require(!inputs.tools.empty() && inputs.tool_choice != COMMON_CHAT_TOOL_CHOICE_NONE, "tools disabled");
+            std::vector<common_peg_parser> alternatives;
+            for (const auto & entry : inputs.tools) {
+                tool = &entry;
+                alternatives.push_back(p.tag("runtime-tool", p.eps()) + child());
+            }
+            tool = nullptr;
+            return p.choice(alternatives);
+        }
+        if (op == "name") {
+            require(tool, "name outside tools");
+            // Names are literal bytes. Quote/bracket characters belong in data.
+            return p.atomic(p.tag("runtime-name", p.literal(tool->name)));
+        }
+        if (op == "args") {
+            require(tool, "args outside tools");
+            bound.insert(tool->name);
+            if (tool->input_grammar.empty()) { return value(json::parse(tool->parameters), "json", ""); }
+            auto body = leaf(p.string_content('"'), {{"lark_grammar", tool->input_grammar}, {"tool_input_mode", "json_string"}});
+            return p.tag("runtime-json", p.literal("{\"input\":\"") + body + p.literal("\"}"));
+        }
+        if (op == "input") {
+            require(tool && !tool->input_grammar.empty(), "input needs an input_grammar tool");
+            bound.insert(tool->name);
+            const auto stop = node.at("stop").get<std::string>();
+            require(!stop.empty(), "input needs a closing delimiter");
+            return leaf(p.tag("runtime-string", p.until(stop)),
+                {{"lark_grammar", tool->input_grammar}, {"tool_input_mode", "raw"}, {"tool_input_stop", stop}});
+        }
+        if (op == "parameters") {
+            require(tool && tool->input_grammar.empty() && property.is_null(), "parameters needs ordinary tool arguments");
+            auto schema = json::parse(tool->parameters);
+            require(schema.is_object() && schema.value("type", "") == "object" &&
+                    schema.contains("properties") && schema.at("properties").is_object() &&
+                    schema.contains("additionalProperties") && schema.at("additionalProperties") == false,
+                    "parameters requires a closed object schema; use args for general JSON Schema");
+            static const std::set<std::string> allowed = {"type", "properties", "required", "additionalProperties", "title", "description"};
+            for (const auto & item : schema.items()) { require(allowed.count(item.key()), "unsupported object constraint in parameters: " + item.key()); }
+            std::set<std::string> required;
+            for (const auto & name : schema.value("required", json::array())) { required.insert(name.get<std::string>()); }
+            for (const auto & name : required) { require(schema.at("properties").contains(name), "required property missing from properties"); }
+            bound.insert(tool->name);
+            std::vector<common_peg_parser> parts;
+            std::vector<bool> mandatory;
+            for (const auto & item : schema.at("properties").items()) {
+                property_name = item.key(); property = item.value();
+                auto part = child();
+                parts.push_back(part);
+                mandatory.push_back(required.count(property_name) != 0);
+            }
+            property = nullptr; property_name.clear();
+            auto after = p.eps(), first = p.eps();
+            const auto separator = node.value("separator", "");
+            for (size_t i = parts.size(); i-- > 0;) {
+                auto with_separator = p.literal(separator) + parts[i] + after;
+                auto without_separator = parts[i] + after;
+                after = p.rule("parameters-after-" + std::to_string(nodes) + "-" + std::to_string(i),
+                    mandatory[i] ? with_separator : (with_separator | after));
+                first = p.rule("parameters-first-" + std::to_string(nodes) + "-" + std::to_string(i),
+                    mandatory[i] ? without_separator : (without_separator | first));
+            }
+            return emit("{") + first + emit("}");
+        }
+        if (op == "parameter_name") {
+            require(!property.is_null(), "parameter_name outside parameters");
+            return p.atomic(p.tag("runtime-key", p.literal(property_name)));
+        }
+        if (op == "parameter_value") {
+            require(!property.is_null(), "parameter_value outside parameters");
+            if (node.value("scalar_only", false)) {
+                const auto type = property.value("type", "");
+                require(type == "string" || type == "integer" || type == "number" || type == "boolean" || type == "null",
+                        "this descriptor value codec only supports scalar properties");
+            }
+            return value(property, node.value("encoding", "json"), node.value("stop", ""));
+        }
+        throw std::invalid_argument("native_tool_format: unknown operation " + op);
+    }
+};
+} // namespace
+
+common_chat_params common_chat_apply_runtime_format(const common_chat_template & tmpl,
+        const autoparser::generation_params & params, const common_chat_templates_inputs & inputs) {
+#ifndef LLAMA_USE_LLGUIDANCE
+    throw std::invalid_argument("native_tool_format requires LLAMA_LLGUIDANCE=ON");
+#endif
+    const auto & spec = inputs.native_tool_format;
+    if (!spec.is_object() || spec.value("version", 0) != 1 || spec.dump().size() > 1024 * 1024) {
+        throw std::invalid_argument("native_tool_format: expected version 1 descriptor, at most 1 MiB");
+    }
+    if (!inputs.grammar.empty() || !inputs.json_schema.empty() || inputs.force_pure_content ||
+        inputs.continue_final_message != COMMON_CHAT_CONTINUATION_NONE) {
+        throw std::invalid_argument("native_tool_format cannot combine with grammar, response schema, pure content or continuation");
+    }
+    std::set<std::string> names;
+    for (const auto & tool : inputs.tools) {
+        if (!names.insert(tool.name).second) { throw std::invalid_argument("native_tool_format: duplicate tool name"); }
+        if (tool.name.empty() || tool.name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-") != std::string::npos) {
+            throw std::invalid_argument("native_tool_format: tool name must use ASCII letters, digits, underscore, dot or dash");
+        }
+    }
+    common_chat_params data;
+    data.prompt = common_chat_template_direct_apply_impl(tmpl, params);
+    data.generation_prompt = common_chat_template_generation_prompt_impl(tmpl, params);
+    data.format = COMMON_CHAT_FORMAT_PEG_RUNTIME;
+    data.preserved_tokens = spec.value("preserved_tokens", std::vector<std::string>{});
+    data.additional_stops = spec.value("additional_stops", std::vector<std::string>{});
+    data.supports_thinking = inputs.enable_thinking;
+    data.thinking_start_tag = spec.value("thinking_start", "");
+    data.thinking_end_tags = spec.value("thinking_end", std::vector<std::string>{});
+    std::map<std::string, json> external;
+    data.parser = build_chat_peg_parser([&](common_chat_peg_builder & p) {
+        format_compiler compiler{p, inputs, spec, data.generation_prompt};
+        auto root = compiler.compile(spec.at("root"));
+        if (inputs.tool_choice != COMMON_CHAT_TOOL_CHOICE_NONE && compiler.bound != names) {
+            throw std::invalid_argument("native_tool_format: every tool must bind its arguments to grammar/schema");
+        }
+        external = std::move(compiler.external);
+        return p.literal(data.generation_prompt) + root + p.end();
+    });
+    const auto gbnf = build_grammar([&](const common_grammar_builder & builder) { data.parser.build_grammar(builder); });
+    llama_grammar_parser parsed;
+    if (!parsed.parse(gbnf.c_str())) { throw std::invalid_argument("native_tool_format: invalid generated grammar"); }
+    json grammars = json::array({json::object()});
+    std::map<uint32_t, std::string> replacements;
+    for (auto & entry : external) {
+        const auto id = parsed.symbol_ids.at(entry.first);
+        const auto name = "body" + std::to_string(grammars.size());
+        replacements[id] = "@" + name;
+        entry.second["name"] = name;
+        grammars.push_back(std::move(entry.second));
+    }
+    grammars[0] = {{"name", "native"}, {"lark_grammar", emit_lark(parsed, "r", replacements) +
+        "start: r" + std::to_string(parsed.symbol_ids.at("root")) + "\n"}};
+    auto markers = data.preserved_tokens;
+    markers.push_back(data.generation_prompt);
+    data.grammar = "%llguidance-json\n" + json{{"grammars", grammars}, {"native_tokens", markers}}.dump();
+    return data;
+}
+
+common_chat_msg common_chat_runtime_map(const common_peg_ast_arena & arena, const common_peg_parse_result & parsed) {
+    common_chat_msg result;
+    result.role = "assistant";
+    common_chat_tool_call * call = nullptr;
+    bool has_key = false;
+    arena.visit(parsed, [&](const common_peg_ast_node & node) {
+        const auto text = node.sanitized_text();
+        if (node.tag == "content") { result.content += text; }
+        else if (node.tag == "reasoning") { result.reasoning_content += text; }
+        else if (node.tag == "runtime-tool") { call = nullptr; has_key = false; }
+        else if (node.tag == "runtime-name") {
+            result.tool_calls.push_back({text, "", ""});
+            call = &result.tool_calls.back();
+        } else if (call) {
+            if (node.tag == "runtime-json") { call->arguments += text; }
+            else if (node.tag == "runtime-string") {
+                auto quoted = json(text).dump();
+                if (node.is_partial) { quoted.pop_back(); }
+                call->arguments += quoted;
+            } else if (node.tag == "runtime-key") {
+                if (has_key) { call->arguments += ","; }
+                call->arguments += json(text).dump() + ":";
+                has_key = true;
+            } else if (node.tag.compare(0, 13, "runtime-emit:") == 0) { call->arguments += node.tag.substr(13); }
+        }
+    });
+    return result;
+}
