+void common_chat_apply_tool_grammars(common_chat_params & data, const common_chat_templates_inputs & inputs) {
+    if (inputs.tool_choice == COMMON_CHAT_TOOL_CHOICE_NONE) { return; }
+    if (std::none_of(inputs.tools.begin(), inputs.tools.end(), [](const common_chat_tool & tool) { return !tool.input_grammar.empty(); })) { return; }
+    common_chat_tool_grammar compiler(data.parser, inputs);
+    if (compiler.bodies.empty()) { return; }
+#ifndef LLAMA_USE_LLGUIDANCE
+    throw std::invalid_argument("input_grammar requires LLAMA_LLGUIDANCE=ON");
+#endif
+    if (!inputs.use_jinja || !inputs.grammar.empty() || !inputs.json_schema.empty() || inputs.force_pure_content ||
+        inputs.continue_final_message != COMMON_CHAT_CONTINUATION_NONE) {
+        throw std::invalid_argument("input_grammar requires native Jinja without custom grammar, response schema or continuation");
+    }
+    auto root = compiler.compile(data.parser.root());
+    if (root.node == COMMON_PEG_INVALID_PARSER_ID || compiler.bound.size() != compiler.bodies.size() ||
+        compiler.validated_tools.size() != compiler.parameters.size()) {
+        auto error = compiler.encoding_errors.empty() ? "no supported native body binding" : compiler.encoding_errors.front();
