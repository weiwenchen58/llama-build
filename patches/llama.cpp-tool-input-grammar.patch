new file mode 100644
index 0000000..095267c
--- /dev/null
+++ b/tests/test-tool-input-grammar.cpp
@@ -0,0 +1,254 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "chat.h"
+#include "llguidance.h"
+
+#include <cassert>
+#include <algorithm>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <sstream>
+
+using json = common_json;
+using matcher_ptr = std::unique_ptr<LlgMatcher, decltype(&llg_free_matcher)>;
+static LlgTokenizer * tokenizer;
+static const std::vector<std::string> pieces = {"<tool_call>", "</tool_call>", "\\n", "\\\"", "<function", "</param>", "</function>"};
+
+static matcher_ptr matcher(const std::string & grammar) {
+    LlgConstraintInit init;
+    llg_constraint_init_set_defaults(&init, tokenizer);
+    return matcher_ptr(llg_new_matcher(&init, "llguidance", grammar.c_str()), llg_free_matcher);
+}
+
+static bool accepts(const std::string & grammar, const std::string & text, bool compound = false, bool diagnostic = false) {
+    auto m = matcher(grammar);
+    if (const char * error = llg_matcher_get_error(m.get())) {
+        throw std::runtime_error(std::string(error) + "\n" + grammar);
+    }
+    for (size_t pos = 0; pos < text.size();) {
+        uint32_t token = static_cast<unsigned char>(text[pos]);
+        size_t length = 1;
+        if (compound) {
+            for (size_t i = 0; i < pieces.size(); ++i) {
+                if (text.compare(pos, pieces[i].size(), pieces[i]) == 0) {
+                    token = 257 + i;
+                    length = pieces[i].size();
+                    break;
+                }
+            }
+        }
+        assert(llg_matcher_compute_mask(m.get()) == 0);
+        const auto * mask = llg_matcher_get_mask(m.get());
+        if (!(mask[token / 32] & (1u << (token % 32)))) {
+            if (diagnostic) { std::cerr << "Rejected at byte " << pos << ": " << json(text.substr(pos, length)).dump() << "\n"; }
+            return false;
+        }
+        assert(llg_matcher_consume_token(m.get(), token) == 0);
+        pos += length;
+    }
+    return llg_matcher_is_accepting(m.get());
+}
+
+static std::string body_grammar(const std::string & definition, const std::string & mode) {
+    return json{{"grammars", json::array({
+        {{"name", "outer"}, {"lark_grammar", "start: \"BEGIN\" @body \"END\""}},
+        {{"name", "body"}, {"lark_grammar", definition}, {"tool_input_mode", mode}}
+    })}}.dump();
+}
+
+static json tool(const std::string & name, const std::string & grammar = "") {
+    json schema = {{"type", "object"}, {"properties", {{"input", {{"type", "string"}}}}},
+                   {"required", json::array({"input"})}, {"additionalProperties", false}};
+    if (grammar.empty()) {
+        schema["properties"] = {{"path", {{"type", "string"}}}};
+        schema["required"] = json::array({"path"});
+    }
+    json function = {{"name", name}, {"description", name}, {"parameters", schema}};
+    if (!grammar.empty()) {
+        function["input_grammar"] = {{"syntax", "lark"}, {"definition", grammar}};
+    }
+    return {{"type", "function"}, {"function", function}};
+}
+
+static common_chat_params apply(const std::string & file, const json & tools, bool required, bool parallel, bool none = false, const std::string & profile = "qwen-json") {
+    std::ifstream stream("models/templates/" + file);
+    assert(stream.good());
+    std::stringstream text;
+    text << stream.rdbuf();
+    auto tmpl = common_chat_templates_init(nullptr, text.str(), "", "");
+    common_chat_templates_inputs inputs;
+    common_chat_msg msg;
+    msg.role = "user";
+    msg.content = "Use the appropriate tool.";
+    inputs.messages = {msg};
+    inputs.tools = common_chat_tools_parse_oaicompat(tools);
+    inputs.enable_thinking = false;
+    inputs.tool_choice = none ? COMMON_CHAT_TOOL_CHOICE_NONE :
+        (required ? COMMON_CHAT_TOOL_CHOICE_REQUIRED : COMMON_CHAT_TOOL_CHOICE_AUTO);
+    inputs.parallel_tool_calls = parallel;
+    std::ifstream descriptor("tests/runtime-tool-formats/" + profile + ".json");
+    assert(descriptor.good());
+    descriptor >> inputs.native_tool_format;
+    return common_chat_templates_apply(tmpl.get(), inputs);
+}
+
+static std::string grammar(const common_chat_params & p) {
+    const std::string prefix = "%llguidance-json\n";
+    assert(p.grammar.find(prefix) == 0);
+    return p.grammar.substr(prefix.size());
+}
+
+static void check(const common_chat_params & p, const std::string & text, bool valid) {
+    const std::string prefill = p.grammar_lazy ? "" : p.generation_prompt;
+    const bool bytes = accepts(grammar(p), prefill + text);
+    const bool compound = accepts(grammar(p), prefill + text, true);
+    if (bytes != valid || compound != valid) {
+        std::cerr << "Expected=" << valid << " byte=" << bytes << " compound=" << compound << "\n";
+        accepts(grammar(p), prefill + text, false, true);
+        accepts(grammar(p), prefill + text, true, true);
+        throw std::runtime_error("unexpected acceptance: " + text + "\n" + grammar(p));
+    }
+}
+
+static common_chat_msg parse(const common_chat_params & p, const std::string & text, bool partial = false) {
+    common_chat_parser_params pp(p);
+    pp.parser = p.parser;
+    return common_chat_parse(common_chat_input(text), partial, pp);
+}
+
+static void expect_error(const std::function<void()> & action) {
+    bool failed = false;
+    try { action(); } catch (const std::exception &) { failed = true; }
+    assert(failed);
+}
+
+int main() {
+    // A byte vocabulary exercises token masks without any model or tokenizer download.
+    std::vector<uint32_t> lengths(257, 1);
+    std::vector<uint8_t> bytes;
+    for (int c = 0; c < 256; ++c) { bytes.push_back(c); }
+    lengths[256] = 4;
+    bytes.insert(bytes.end(), {255, 'E', 'O', 'S'});
+    for (const auto & piece : pieces) {
+        lengths.push_back(piece.size());
+        bytes.insert(bytes.end(), piece.begin(), piece.end());
+    }
+    LlgTokenizerInit ti = {};
+    ti.vocab_size = lengths.size();
+    ti.tok_eos = 256;
+    ti.token_lens = lengths.data();
+    ti.token_bytes = bytes.data();
+    ti.use_approximate_greedy_tokenize_fn = true;
+    char error[2048];
+    tokenizer = llg_new_tokenizer(&ti, error, sizeof(error));
+    if (!tokenizer) { throw std::runtime_error(error); }
+
+    const std::string recursive = "start: expr\nexpr: NUMBER | \"(\" expr \"+\" expr \")\"\nNUMBER: /[0-9]+/\n%ignore /[ ]+/";
+    const std::string patch = "start: \"*** Begin Patch\\n*** Delete File: \" PATH \"\\n*** End Patch\"\nPATH: /[^\\r\\n]+/";
+    auto body = body_grammar(recursive, "json_string");
+    assert(accepts(body, "BEGIN(1+(2+3))END"));
+    assert(accepts(body, "BEGIN( 1 + (2+3))END"));
+    assert(!accepts(body, "BEGIN(1+(2+3)END"));
+    assert(!accepts(body, "BEGIN(1*2)END"));
+    const std::string literal = std::string("line\n\"quote\"\\") + "\xe4\xb8\xad\xe6\x96\x87" + '\0';
+    auto quoted = json(literal).dump();
+    body = body_grammar("start: " + json(literal).dump(), "json_string");
+    assert(accepts(body, "BEGIN" + quoted.substr(1, quoted.size() - 2) + "END"));
+    assert(!accepts(body, "BEGIN" + literal + "END"));
+    assert(accepts(body_grammar("start: \"\"", "json_string"), "BEGINEND"));
+    auto controls = body_grammar("start: /[\\x00-\\x1f]+/", "json_string");
+    assert(accepts(controls, "BEGIN\\n\\tEND"));
+    assert(!accepts(controls, "BEGIN\\\"END"));
+    assert(!accepts(controls, "BEGIN\\\\END"));
+    auto character = body_grammar(R"(start: /[^\r\n"]/)", "json_string");
+    for (int c = 0; c < 128; ++c) {
+        auto encoded = json(std::string(1, static_cast<char>(c))).dump();
+        const auto sample = "BEGIN" + encoded.substr(1, encoded.size() - 2) + "END";
+        const bool expected = c != '\r' && c != '\n' && c != '"';
+        if (accepts(character, sample) != expected) {
+            std::cerr << "Character mismatch: " << c << " expected=" << expected << "\n";
+            accepts(character, sample, false, true);
+            throw std::runtime_error("JSON character class mismatch");
+        }
+    }
+    auto ignored = body_grammar("start: \"a\" \"\\\"\"\n%ignore /[\\n\\t ]+/", "json_string");
+    assert(accepts(ignored, "BEGIN\\na\\t\\\"\\nEND"));
+
+    auto raw_grammar = [](const std::string & definition, const std::string & stop) {
+        return json{{"grammars", json::array({
+            {{"name", "outer"}, {"lark_grammar", "start: @body " + json(stop).dump()}},
+            {{"name", "body"}, {"lark_grammar", definition}, {"tool_input_mode", "raw"}, {"tool_input_stop", stop}}
+        })}}.dump();
+    };
+    assert(accepts(raw_grammar(recursive, "</param>"), "(1+(2+3))</param>"));
+    assert(accepts(raw_grammar("start: \"<div>ok</div>\"", "</param>"), "<div>ok</div></param>"));
+    // Boundary collisions across productions, recursion, ignores and suffix overlap.
+    for (const auto & source : {"start: \"</param>\"", "start: a b\na: \"</pa\"\nb: \"ram>\"",
+            "start: x\nx: \"x\" x | \"</param>\"", "start: \"ok\"\n%ignore /<\\/param>/"}) {
+        auto m = matcher(raw_grammar(source, "</param>"));
+        assert(llg_matcher_get_error(m.get()));
+    }
+    { auto m = matcher(raw_grammar("start: \"ab\"", "aba")); assert(llg_matcher_get_error(m.get())); }
+    // Prefix A + a possible delimiter prefix must not bypass the body requirement AB.
+    auto boundary = matcher(raw_grammar("start: \"AB\"", "\n</parameter>\n"));
+    assert(!llg_matcher_get_error(boundary.get()));
+    assert(llg_matcher_consume_token(boundary.get(), 'A') == 0);
+    assert(llg_matcher_compute_mask(boundary.get()) == 0);
+    auto mask = llg_matcher_get_mask(boundary.get());
+    assert(!(mask['\n' / 32] & (1u << ('\n' % 32))));
+    assert(mask['B' / 32] & (1u << ('B' % 32)));
+
+    std::ifstream cases_stream("tests/runtime-tool-formats/tests.json");
+    assert(cases_stream.good());
+    json cases; cases_stream >> cases;
+    for (const auto & entry : cases) {
+        const std::string profile = entry.at("profile"), file = entry.at("template");
+        const auto & tools = entry.at("tools");
+        std::cerr << "Testing runtime format: " << profile << "\n";
+        auto p = apply(file, tools, false, true, false, profile);
+        check(p, "Hello", true);
+        for (const auto & sample : entry.at("accept")) {
+            const std::string text = sample.at("text");
+            check(p, text, true);
+            check(p, text + text, true);
+            auto msg = parse(p, text);
+            assert(msg.tool_calls.size() == 1);
+            assert(msg.tool_calls[0].name == sample.at("name"));
+            if (json::parse(msg.tool_calls[0].arguments) != sample.at("arguments")) {
+                throw std::runtime_error("mapping mismatch " + msg.tool_calls[0].arguments);
+            }
+            // Streaming deltas must concatenate to the exact final arguments.
+            std::string previous;
+            for (size_t i = 0; i < text.size(); ++i) {
+                // Do not split UTF-8 inside a code point: actual incomplete-token
+                // bytes are buffered by the server before response parsing.
+                if (i && (static_cast<unsigned char>(text[i]) & 0xc0) == 0x80) { continue; }
+                auto partial = parse(p, text.substr(0, i), true);
+                if (partial.tool_calls.empty()) { continue; }
+                const auto & current = partial.tool_calls[0].arguments;
+                assert(current.compare(0, previous.size(), previous) == 0);
+                assert(msg.tool_calls[0].arguments.compare(0, current.size(), current) == 0);
+                previous = current;
+            }
+            auto single = apply(file, tools, true, false, false, profile);
+            check(single, text, true);
+            check(single, "Hello", false);
+            check(single, text + text, false);
+            check(single, text.substr(0, text.size() - 1), false);
+            expect_error([&] { parse(single, text.substr(0, text.size() - 1)); });
+        }
+        for (const auto & rejected : entry.at("reject")) { check(p, rejected.get<std::string>(), false); }
+        auto disabled = apply(file, tools, false, true, true, profile);
+        check(disabled, "Hello", true);
+        assert(parse(disabled, "Hello").tool_calls.empty());
+    }
+    // No descriptor fallback for grammar tools: fail before unconstrained sampling.
+    auto bad = tool("calculate", recursive);
+    bad["function"]["parameters"]["required"] = json::array();
+    expect_error([&] { common_chat_tools_parse_oaicompat(json::array({bad})); });
+    llg_free_tokenizer(tokenizer);
+    std::cout << "Runtime format tests passed (no model loaded).\n";
+}
